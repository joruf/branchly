# Virtual environment and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Output of build-exe.py
/build/
/dist/

# Local state written at runtime
# Derived from the history after every commit; a checked-in copy would be
# stale one commit later.
/VERSION
settings.json
repos.json
*.tmp

# Editor and OS clutter
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
