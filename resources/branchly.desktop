[Desktop Entry]
Type=Application
Version=1.0
Name=Branchly
GenericName=Git client
Comment=Manage your Git projects without the command line
Comment[de]=Git-Projekte verwalten ohne Kommandozeile
# %k is this .desktop file. branchly.sh lives in the project root, one directory up.
Exec=/bin/bash -c "cd \\$(dirname \\$(readlink -f \\$0))/.. && exec ./branchly.sh \\"\\$@\\"" %k %f
Icon=branchly
Terminal=false
Categories=Development;RevisionControl;
Keywords=git;version control;repository;commit;merge;
Keywords[de]=git;versionsverwaltung;repository;commit;zusammenführen;
StartupNotify=true
StartupWMClass=Branchly
